<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Jetons de couleur — thème sombre (direction retenue, cahier des charges §10). Valeurs de
        départ à contrôler en recette (contraste réel de chaque état, thème clair et contraste
        système à ajouter au lot 6).
    -->
    <SolidColorBrush x:Key="Brush.Background" Color="#171C26" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#222A38" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C3CDDC" />
    <!-- Accent : texte, bordures et anneau de focus (clair, ≥ 6:1 sur la surface). -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#7DB2FF" />
    <!-- AccentFill : fond du bouton principal, texte blanc dessus (≥ 5:1). -->
    <SolidColorBrush x:Key="Brush.AccentFill" Color="#1F5FD6" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2F72EE" />
    <SolidColorBrush x:Key="Brush.Success" Color="#5FD3A0" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFC266" />
    <SolidColorBrush x:Key="Brush.Error" Color="#FF8F8F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#3A4558" />

    <FontFamily x:Key="Font.Default">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display</FontFamily>

    <!--
        Anneau de focus clavier (§65, §125) : 2 px, décalé, contraste garanti par l'accent
        choisi ci-dessus. Appliqué explicitement (voir Style.Triggers ci-dessous) plutôt que
        de dépendre du style système, pour être certain qu'il n'est jamais supprimé par erreur.
    -->
    <Style x:Key="Style.KeyboardFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" StrokeThickness="2" Stroke="{StaticResource Brush.Accent}"
                               StrokeDashArray="0" RadiusX="4" RadiusY="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Bouton principal. Cible tactile ≥ 44x44 px (§66). Le focus clavier utilise le style
        ci-dessus, jamais désactivé — voir FocusVisualStyle plutôt qu'un
        "FocusVisualStyle=x:Null" qu'on pourrait être tenté d'ajouter pour "nettoyer" le rendu.
    -->
    <Style x:Key="Style.PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.AccentFill}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.KeyboardFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Carte surélevée — une seule surface élevée à l'écran d'accueil (plan §10.3). -->
    <Style x:Key="Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="48" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="24" ShadowDepth="4" Direction="270" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.Heading1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Style.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Default}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

</ResourceDictionary>
