<UserControl x:Class="PlanningConverter.Ui.Views.AnalyzingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:PlanningConverter.Ui.Behaviors"
             Background="{StaticResource Brush.Background}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
        <TextBlock Text="Analyse en cours" Style="{StaticResource Style.Heading1}"
                   AutomationProperties.HeadingLevel="Level1" Focusable="True"
                   beh:FocusOnLoad.Enabled="True" TextAlignment="Center" />
        <TextBlock Text="{Binding FileName}" Style="{StaticResource Style.Subtitle}"
                   TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Stage}" Style="{StaticResource Style.Subtitle}"
                   Foreground="{StaticResource Brush.Accent}"
                   TextAlignment="Center" Margin="0,24,0,0" />
        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,16,0,32"
                     Foreground="{StaticResource Brush.Accent}" Background="{StaticResource Brush.Border}"
                     BorderThickness="0" AutomationProperties.Name="Analyse en cours" />
        <Button Content="Annuler" Command="{Binding CancelCommand}"
                Style="{StaticResource Style.SecondaryButton}" HorizontalAlignment="Center"
                AutomationProperties.Name="Annuler l'analyse" />
    </StackPanel>
</UserControl>
