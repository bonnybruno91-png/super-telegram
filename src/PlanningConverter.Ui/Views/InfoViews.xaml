<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PlanningConverter.Ui.ViewModels"
                    xmlns:beh="clr-namespace:PlanningConverter.Ui.Behaviors"
                    xmlns:conv="clr-namespace:PlanningConverter.Ui.Converters">

    <DataTemplate DataType="{x:Type vm:HelpViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Background}">
            <StackPanel Margin="32,24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Aide" Style="{StaticResource Style.Heading2}" AutomationProperties.HeadingLevel="Level1"
                           Focusable="True" beh:FocusOnLoad.Enabled="True" />
                <ItemsControl ItemsSource="{Binding Sections}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="15" Margin="0,6,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Brush.Background}">
            <StackPanel Margin="32,24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Historique" Style="{StaticResource Style.Heading2}" AutomationProperties.HeadingLevel="Level1"
                           Focusable="True" beh:FocusOnLoad.Enabled="True" />
                <TextBlock Text="Aucune conversion enregistrée pour l'instant." Style="{StaticResource Style.Subtitle}" Margin="0,16,0,0"
                           Visibility="{Binding IsEmpty, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}" />
                <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.Surface}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                    AutomationProperties.Name="{Binding Title}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
