<UserControl x:Class="PlanningConverter.Ui.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:PlanningConverter.Ui.Behaviors"
             xmlns:conv="clr-namespace:PlanningConverter.Ui.Converters"
             Background="{StaticResource Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Enregistrer le planning" Style="{StaticResource Style.Heading2}"
                       AutomationProperties.HeadingLevel="Level1" Focusable="True"
                       beh:FocusOnLoad.Enabled="True" />
            <TextBlock Text="{Binding PlanText}" Style="{StaticResource Style.Subtitle}" Margin="0,4,0,16" TextWrapping="Wrap" />

            <TextBlock Text="Formats" Style="{StaticResource Style.Label}" />
            <CheckBox IsChecked="{Binding IcsSelected}" Style="{StaticResource Style.CheckBox}"
                      Content="Calendrier (ICS) — pour Google Agenda, Outlook, iPhone, Android" />
            <CheckBox IsChecked="{Binding TxtSelected}" Style="{StaticResource Style.CheckBox}"
                      Content="Texte accessible (TXT) — pour lecteur d'écran ou impression" />
            <CheckBox IsChecked="{Binding CsvSelected}" Style="{StaticResource Style.CheckBox}"
                      Content="Tableur (CSV) — pour Excel ou import personnalisé" />
            <CheckBox IsChecked="{Binding PdfSelected}" Style="{StaticResource Style.CheckBox}"
                      Content="PDF gros caractères — pour imprimer ou agrandir (non balisé : préférez le TXT avec un lecteur d'écran)" />
            <TextBlock Text="{Binding FileCountText}" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,0" />

            <TextBlock Text="Dossier de destination" Style="{StaticResource Style.Label}" Margin="0,20,0,4" />
            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Style.TextBox}" AutomationProperties.Name="Dossier de destination" />
            <Button Content="Changer de dossier" Command="{Binding ChangeFolderCommand}"
                    Style="{StaticResource Style.SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="Enregistrer" Command="{Binding SaveCommand}"
                        Style="{StaticResource Style.PrimaryButton}" Margin="0,0,12,0"
                        AutomationProperties.Name="Enregistrer les fichiers dans le dossier choisi" />
                <Button Content="Retour à la vérification" Command="{Binding BackCommand}"
                        Style="{StaticResource Style.SecondaryButton}" />
            </StackPanel>

            <Border Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="20" Margin="0,24,0,0"
                    Visibility="{Binding HasResult, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding ResultDetail}" TextWrapping="Wrap" Margin="0,8,0,12"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <Button Content="Ouvrir le dossier" Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource Style.SecondaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
