<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Seul ce projet cible Windows : c'est WPF qui l'exige (plan §2.1, §2.2). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>PlanningConverter</AssemblyName>
    <RootNamespace>PlanningConverter.Ui</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon></ApplicationIcon>
    <!-- §117 : exécutable autonome, sans prérequis à installer. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Volontairement PAS de référence à Spreadsheet/Parsing/Export (règle d'architecture,
      plan §3.2) : cette couche ne parle qu'à Application, qui compose le reste.
    -->
    <ProjectReference Include="..\PlanningConverter.Domain\PlanningConverter.Domain.csproj" />
    <ProjectReference Include="..\PlanningConverter.Storage\PlanningConverter.Storage.csproj" />
    <ProjectReference Include="..\PlanningConverter.Application\PlanningConverter.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions à vérifier au moment du build (§89) — non confirmables depuis ce sandbox. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
</Project>
