<Window x:Class="PlanningConverter.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlanningConverter.Ui.ViewModels"
        xmlns:views="clr-namespace:PlanningConverter.Ui.Views"
        Title="Planning Converter"
        Width="1100" Height="720" MinWidth="720" MinHeight="480"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource Font.Default}">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Views/InfoViews.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- Association type de ViewModel → vue (plan §10.1 : une seule fenêtre, navigation interne). -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyzingViewModel}">
            <views:AnalyzingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VerifyViewModel}">
            <views:VerifyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView />
        </DataTemplate>

        <!-- Pastille d'étape : le texte dit toujours « étape N sur 3 », la couleur ne porte pas seule le sens. -->
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,24,0" />
        </Style>

        <Style x:Key="StepImport" TargetType="TextBlock" BasedOn="{StaticResource StepText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStepImport}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepVerify" TargetType="TextBlock" BasedOn="{StaticResource StepText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStepVerify}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepExport" TargetType="TextBlock" BasedOn="{StaticResource StepText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStepExport}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Border}" />
                </Trigger>
                <!-- §63 : rail replié en dessous de 900 px — non implémenté dans cette version
                     (TODO §123), le rail reste toujours développé pour l'instant. -->
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Rail de navigation : libellés textuels toujours visibles à côté des icônes (§63). -->
            <StackPanel Grid.Column="0" Background="{StaticResource Brush.Surface}" Margin="0" >
                <TextBlock Text="Planning Converter" FontWeight="SemiBold" FontSize="16"
                           Margin="20,24,20,24" Foreground="{StaticResource Brush.TextPrimary}" />

                <Button Content="Nouvelle conversion" Style="{StaticResource NavItem}" Margin="12,0,12,4"
                        Command="{Binding NewConversionCommand}"
                        AutomationProperties.Name="Nouvelle conversion" />
                <Button Content="Historique" Style="{StaticResource NavItem}" Margin="12,0,12,4"
                        Command="{Binding ShowHistoryCommand}" AutomationProperties.Name="Historique" />
                <Button Content="Modèles" Style="{StaticResource NavItem}" Margin="12,0,12,4"
                        IsEnabled="False" AutomationProperties.Name="Modèles — pas encore disponible" />
                <Button Content="Paramètres" Style="{StaticResource NavItem}" Margin="12,0,12,4"
                        IsEnabled="False" AutomationProperties.Name="Paramètres — pas encore disponible" />
                <Button Content="Aide" Style="{StaticResource NavItem}" Margin="12,0,12,4"
                        Command="{Binding ShowHelpCommand}" AutomationProperties.Name="Aide" />
            </StackPanel>

            <!-- Zone de contenu : une seule vue à la fois. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Stepper Importer / Vérifier / Exporter -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="32,16,32,0"
                            AutomationProperties.Name="Étapes de la conversion">
                    <TextBlock Text="1. Importer" Style="{StaticResource StepImport}"
                               AutomationProperties.Name="Étape 1 sur 3 : importer" />
                    <TextBlock Text="2. Vérifier" Style="{StaticResource StepVerify}"
                               AutomationProperties.Name="Étape 2 sur 3 : vérifier" />
                    <TextBlock Text="3. Exporter" Style="{StaticResource StepExport}"
                               AutomationProperties.Name="Étape 3 sur 3 : exporter" />
                </StackPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Barre de statut / région live (§64) : annoncée aux lecteurs d'écran à chaque changement. -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
